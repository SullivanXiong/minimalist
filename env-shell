#!/bin/bash
# Run a command inside the current `nix develop` environment without starting an
# interactive session. Useful for firing off commands in environments where
# setting up a full nix-aware shell is inconvenient.

# Load spacetime if available
if [ -f "$HOME/.config/spacetime/spacetime.rc" ]; then
    source "$HOME/.config/spacetime/spacetime.rc"
fi

DEVENV_ROOT="file+file://$(pwd)/.devenv/root"
NIX_ARGS="-L develop --no-pure-eval --override-input devenv-root $DEVENV_ROOT"

if [ "$#" -eq 0 ]; then
  nix $NIX_ARGS
elif [ "$#" -eq 1 ]; then
  nix $NIX_ARGS --command bash -lc "$1"
else
  nix $NIX_ARGS --command "$@"
fi

