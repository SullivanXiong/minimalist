#!/bin/bash
# Automatically load development environment

watch_file flake.nix
watch_file flake.lock

# Create devenv root marker
mkdir -p "$PWD/.devenv"
DEVENV_ROOT_FILE="$PWD/.devenv/root"
printf %s "$PWD" > "$DEVENV_ROOT_FILE"

# Load spacetime if available
if [ -f "$HOME/.config/spacetime/spacetime.rc" ]; then
    source "$HOME/.config/spacetime/spacetime.rc"
fi

# Export project-specific variables
export PROJECT_ROOT="$PWD"
export SPACETIME_WORKSPACE="${SPACETIME_WORKSPACE:-$HOME/workspace}"

# Load the nix devenv
if ! use flake . --override-input devenv-root "file+file://$DEVENV_ROOT_FILE"; then
    echo "⚠️  devenv could not be built. The devenv environment was not loaded." >&2
    echo "Make the necessary changes to flake.nix and run 'direnv allow' to try again." >&2
fi

# Project-specific environment
echo "🎯 Loaded minimalist project environment"
echo "📍 Project root: $PROJECT_ROOT"
echo "🌌 Workspace: $SPACETIME_WORKSPACE"

